# Copie para .env (ou .env.local) e ajuste. Arquivos .env não vão para o Git.

# URL do backend, sem barra no final.
# Local:   http://localhost:8080
# Render:  https://leroy-guia-api.onrender.com (exemplo)
# Em branco, o site usa os dados simulados de src/mocks.
VITE_API_URL=

# "true" força os dados simulados mesmo com VITE_API_URL preenchido.
VITE_USE_MOCK=true
